# ===== Frontend (públicas por design no Firebase; a segurança vem das regras) =====
# Projeto Firebase próprio do Gerenciador
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app-gerenciador-de-anuncios.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-gerenciador-de-anuncios
VITE_FIREBASE_STORAGE_BUCKET=app-gerenciador-de-anuncios.firebasestorage.app
VITE_FIREBASE_APP_ID=
# URL pública onde o app estará publicado (usada no link de aprovação enviado ao cliente). Ex.: https://aprovar.seudominio.com/
VITE_URL_PUBLICA=

# ===== Backend (SEGREDOS — nunca com prefixo VITE_) =====
ANTHROPIC_API_KEY=
# auto (padrão): usa SEMPRE primeiro a sua assinatura do Claude (CLI `claude`); a API só quando a assinatura não puder ser usada.
# cli = só assinatura | api = só API. (Testes com API simulada: IA_PROVEDOR=api + ANTHROPIC_BASE_URL)
# IA_CLI_BIN=claude   # caminho do executável, se não estiver no PATH
IA_PROVEDOR=auto
# Haiku para tarefas curtas (hooks, checklist, refinos); Sonnet para as que exigem raciocínio (criativos, mercado, site)
ANTHROPIC_MODEL_LEVE=claude-haiku-4-5
ANTHROPIC_MODEL_COMPLEXO=claude-sonnet-5
FIREBASE_PROJECT_ID=app-gerenciador-de-anuncios
# E-mail do único administrador autorizado a usar a IA (opcional, recomendado)
ADMIN_EMAIL=
PORT=8787

# ===== Somente testes locais (NUNCA em produção) =====
# VITE_DEMO_MODE=1 usa login/dados fictícios em localStorage, sem Firebase.
# DEV_AUTH_BYPASS=1 faz o servidor aceitar o token "demo" fora de produção.
# ANTHROPIC_BASE_URL aponta o servidor para uma API simulada em testes.

# ===== Estúdio de peças (opcional): imagem gerada por IA, vários provedores gratuitos em rodízio =====
# Sem nenhuma chave o estúdio funciona normalmente com as fotos do produto e os templates.
# Ordem de tentativa (só entram os que têm chave). Se um falhar ou acabar a cota do dia, passa ao próximo.
# IMAGEM_PROVEDORES=cloudflare,together,huggingface      # "openai" (pago) só entra se você o listar aqui
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # token com permissão "Workers AI"
# TOGETHER_API_KEY=
# HUGGINGFACE_TOKEN=
# OPENAI_API_KEY=                # PAGO, opcional
# Limite diário do app por provedor (padrões: cloudflare 150, together 100, huggingface 20, openai 10)
# CLOUDFLARE_LIMITE_DIA=150
