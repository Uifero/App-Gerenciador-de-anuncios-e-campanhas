# ===== Frontend (públicas por design no Firebase; a segurança vem das regras) =====
# Mesmo projeto Firebase do Painel de Comissões
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app-comissoes-vortex.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-comissoes-vortex
VITE_FIREBASE_STORAGE_BUCKET=app-comissoes-vortex.appspot.com
VITE_FIREBASE_APP_ID=

# ===== Backend (SEGREDOS — nunca com prefixo VITE_) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
FIREBASE_PROJECT_ID=app-comissoes-vortex
# E-mail do único administrador autorizado a usar a IA (opcional, recomendado)
ADMIN_EMAIL=
PORT=8787

# ===== Somente testes locais (NUNCA em produção) =====
# VITE_DEMO_MODE=1 usa login/dados fictícios em localStorage, sem Firebase.
# DEV_AUTH_BYPASS=1 faz o servidor aceitar o token "demo" fora de produção.
# ANTHROPIC_BASE_URL aponta o servidor para uma API simulada em testes.
