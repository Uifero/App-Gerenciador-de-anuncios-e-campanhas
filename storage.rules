rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mídia do Gerenciador: só autenticado; limite de 100 MB por arquivo.
    match /gcc/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
