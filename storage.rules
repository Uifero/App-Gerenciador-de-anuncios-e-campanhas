rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Prévias em qualidade reduzida da peça final (gcc/<cliente>/previews/<criativo>/...), exibidas no link público
    // de aprovação. Mesma política do restante do fluxo de aprovação: o cliente final só abre a prévia pelo endereço
    // direto que está no snapshot do link (URL de download com token imprevisível); NINGUÉM sem login lista a pasta
    // nem lê por caminho. Gravar: só autenticado, só imagem/vídeo e até 30 MB (a prévia é pequena de propósito).
    match /gcc/{clienteId}/previews/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if request.auth != null;
    }
    // Mídia do Gerenciador: só autenticado; limite de 100 MB por arquivo. As regras somam (OU), por isso a pasta de
    // prévias fica de fora desta (senão o limite de 30 MB e o filtro de tipo acima não valeriam nada).
    // `delete` fica separado: na exclusão não existe request.resource, e a condição de tamanho recusaria o pedido.
    match /gcc/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 100 * 1024 * 1024
        && !allPaths.matches('[^/]+/previews/.*');
      allow delete: if request.auth != null;
    }
  }
}
